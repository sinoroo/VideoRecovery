<Window x:Class="VideoRecovery.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:VideoRecovery.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Video Recovery"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        AutomationProperties.AutomationId="MainWindow">

    <materialDesign:DialogHost Identifier="RootDialog"
                               AutomationProperties.AutomationId="RootDialogHost">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <materialDesign:PackIcon Kind="VideoVintage" Width="40" Height="40"
                                         VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="VIDEO RECOVERY" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="손상된 영상 자동 분석 및 복구 (MVP: 진단)" FontSize="13" Opacity="0.7" />
                </StackPanel>
            </StackPanel>

            <!-- Action bar -->
            <materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="폴더 선택"
                            Command="{Binding SelectFolderCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            AutomationProperties.AutomationId="SelectFolderButton" />

                    <TextBox Grid.Column="1" Margin="16,0"
                             VerticalAlignment="Center"
                             IsReadOnly="True"
                             materialDesign:HintAssist.Hint="선택된 폴더"
                             Text="{Binding SelectedFolder, Mode=OneWay}"
                             AutomationProperties.AutomationId="SelectedFolderText" />

                    <Button Grid.Column="2"
                            Content="분석 시작"
                            Command="{Binding ScanAndAnalyzeCommand}"
                            Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                            AutomationProperties.AutomationId="AnalyzeButton" />
                </Grid>
            </materialDesign:Card>

            <!-- Results -->
            <materialDesign:Card Grid.Row="2" Padding="0">
                <DataGrid ItemsSource="{Binding Videos}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          AutomationProperties.AutomationId="VideoResultsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="2*" />
                        <DataGridTextColumn Header="크기(MB)" Binding="{Binding SizeMb, StringFormat=N1}" Width="*" />
                        <DataGridTextColumn Header="코덱" Binding="{Binding Codec}" Width="*" />
                        <DataGridTextColumn Header="해상도" Binding="{Binding Resolution}" Width="*" />
                        <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- Status bar -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0"
                             Minimum="0" Maximum="1"
                             Height="8"
                             VerticalAlignment="Center"
                             Value="{Binding Progress, Mode=OneWay}"
                             AutomationProperties.AutomationId="AnalyzeProgressBar" />

                <TextBlock Grid.Column="1" Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding StatusMessage}"
                           AutomationProperties.AutomationId="StatusText" />
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
