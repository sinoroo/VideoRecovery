<Window x:Class="VideoRecovery.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:VideoRecovery.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Video Recovery"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        AutomationProperties.AutomationId="MainWindow">

    <materialDesign:DialogHost Identifier="RootDialog"
                               AutomationProperties.AutomationId="RootDialogHost">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <materialDesign:ColorZone Grid.Row="0"
                                      Mode="PrimaryMid"
                                      Padding="20,14"
                                      materialDesign:ElevationAssist.Elevation="Dp4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="VideoVintage" Width="32" Height="32" VerticalAlignment="Center" />
                        <TextBlock Text="VIDEO RECOVERY"
                                   FontSize="22" FontWeight="Bold"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="영상 자동 진단 + 복구 (Phase 2)"
                                   FontSize="13" Opacity="0.8"
                                   Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </materialDesign:ColorZone>

            <!-- Toolbar: 폴더 선택 + 분석 -->
            <materialDesign:Card Grid.Row="1" Margin="16,16,16,8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding BrowseFolderCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            AutomationProperties.AutomationId="BrowseButton">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen" VerticalAlignment="Center" />
                            <TextBlock Text="폴더 선택" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBox Grid.Column="1"
                             Margin="16,0"
                             VerticalAlignment="Center"
                             materialDesign:HintAssist.Hint="진단할 HDD 또는 폴더 경로"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="FolderTextBox" />

                    <CheckBox Grid.Column="2"
                              Content="하위 폴더 포함"
                              Margin="8,0,16,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding Recursive}"
                              AutomationProperties.AutomationId="RecursiveCheckBox" />

                    <Button Grid.Column="3"
                            Command="{Binding AnalyzeCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource SecondaryHueMidBrush}"
                            BorderBrush="{DynamicResource SecondaryHueMidBrush}"
                            AutomationProperties.AutomationId="AnalyzeButton">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" />
                            <TextBlock Text="분석 시작" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4"
                            Margin="8,0,0,0"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            AutomationProperties.AutomationId="CancelButton">
                        <TextBlock Text="취소" />
                    </Button>
                </Grid>
            </materialDesign:Card>

            <!-- Progress + status -->
            <StackPanel Grid.Row="2" Margin="16,0,16,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Command="{Binding RecoverSelectedCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource PrimaryHueMidBrush}"
                            BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                            AutomationProperties.AutomationId="RecoverSelectedButton">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Wrench" VerticalAlignment="Center" />
                            <TextBlock Text="선택 복구" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RecoverAllDamagedCommand}"
                            Margin="8,0,0,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            AutomationProperties.AutomationId="RecoverAllButton">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AutoFix" VerticalAlignment="Center" />
                            <TextBlock Text="손상 전체 복구" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ProgressBar Minimum="0"
                             Maximum="{Binding ProgressMax}"
                             Value="{Binding ProgressValue}"
                             Height="6"
                             IsIndeterminate="{Binding IsBusy}"
                             AutomationProperties.AutomationId="ProgressBar" />
                <TextBlock Text="{Binding StatusMessage}"
                           Margin="2,8,0,0"
                           Opacity="0.75"
                           AutomationProperties.AutomationId="StatusText" />
            </StackPanel>

            <!-- Results grid + detail -->
            <Grid Grid.Row="3" Margin="16,0,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Padding="0">
                    <DataGrid ItemsSource="{Binding Results}"
                              SelectedItem="{Binding SelectedRow}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              materialDesign:DataGridAssist.CellPadding="12,8"
                              AutomationProperties.AutomationId="ResultsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="2*" />
                            <DataGridTextColumn Header="크기" Binding="{Binding SizeText}" Width="Auto" />
                            <DataGridTextColumn Header="심각도" Binding="{Binding SeverityText}" Width="Auto" />
                            <DataGridTextColumn Header="손상 유형" Binding="{Binding CorruptionText}" Width="2*" />
                            <DataGridTextColumn Header="복구 가능성" Binding="{Binding RecoveryProbabilityText}" Width="Auto" />
                            <DataGridTextColumn Header="추천 방법" Binding="{Binding RecommendedMethod}" Width="Auto" />
                            <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceText}" Width="Auto" />
                            <DataGridTextColumn Header="복구 상태" Binding="{Binding RecoveryStatus}" Width="Auto" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDamaged}" Value="True">
                                        <Setter Property="Background" Value="#FFF4E5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </materialDesign:Card>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" Background="Transparent" />

                <!-- Detail panel -->
                <materialDesign:Card Grid.Column="2" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel AutomationProperties.AutomationId="DetailPanel">
                            <TextBlock Text="복구 분석 결과" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

                            <StackPanel Visibility="{Binding SelectedRow, Converter={x:Static vm:NullToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding SelectedRow.FileName}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                <Separator Margin="0,8" />

                                <TextBlock Text="손상 정도" Opacity="0.6" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding SelectedRow.SeverityText}" FontWeight="Medium" />

                                <TextBlock Text="손상 유형" Opacity="0.6" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding SelectedRow.CorruptionText}" TextWrapping="Wrap" />

                                <TextBlock Text="복구 가능성" Opacity="0.6" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding SelectedRow.RecoveryProbabilityText}" FontWeight="Medium" />

                                <TextBlock Text="추천 방법" Opacity="0.6" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding SelectedRow.RecommendedMethod}" FontWeight="Medium" />

                                <TextBlock Text="Reference" Opacity="0.6" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding SelectedRow.ReferenceText}" TextWrapping="Wrap" />

                                <TextBlock Text="요약" Opacity="0.6" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding SelectedRow.Summary}" TextWrapping="Wrap" />

                                <TextBlock Text="복구 상태" Opacity="0.6" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding SelectedRow.RecoveryStatus}" FontWeight="Medium"
                                           AutomationProperties.AutomationId="DetailRecoveryStatus" />

                                <TextBlock Text="복구 결과물 경로" Opacity="0.6" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding SelectedRow.RecoveredPath}" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="DetailRecoveredPath" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Command="{Binding SaveRecoveredCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            AutomationProperties.AutomationId="SaveRecoveredButton">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                            <TextBlock Text="복구본 저장" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding OpenRecoveredFolderCommand}"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            ToolTip="탐색기에서 복구 결과물 보기"
                                            AutomationProperties.AutomationId="OpenRecoveredFolderButton">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderOpen" VerticalAlignment="Center" />
                                            <TextBlock Text="폴더 열기" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <TextBlock Text="복구 상세" Opacity="0.6" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding SelectedRow.RecoveryDetail}" TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Text="행을 선택하면 상세 정보가 표시됩니다."
                                       Opacity="0.5"
                                       Visibility="{Binding SelectedRow, Converter={x:Static vm:NullToVisibilityConverter.InstanceInverted}}" />
                        </StackPanel>
                    </ScrollViewer>
                </materialDesign:Card>
            </Grid>

            <!-- Footer -->
            <TextBlock Grid.Row="4"
                       Margin="16,0,16,12"
                       Opacity="0.5"
                       FontSize="12"
                       Text="원본은 변경되지 않습니다. 복구본은 작업 영역에 생성되며, [복구본 저장]으로 원하는 위치에 저장할 수 있습니다." />
        </Grid>
    </materialDesign:DialogHost>
</Window>
